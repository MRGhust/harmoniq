# Harmoniq Environment Variables (All Optional - Works 100% Zero-Config by default)

# Next.js Public App URL (optional, useful for custom domain social preview)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Supabase Realtime & Persistence (Leave empty to use peer-to-peer WebRTC mesh)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
